{% include "_base.j2" %}
ipv6 unicast-routing
!
{%- for p in pools %}
ip dhcp excluded-address {{ p.excl_first }} {{ p.excl_last }}
{%- endfor %}
!
{%- for p in pools %}
ip dhcp pool {{ p.name }}
 network {{ p.network }} {{ p.mask }}
 default-router {{ p.gw }}
 dns-server {{ dns }}
 domain-name {{ site.domain }}
{%- endfor %}
{%- for r in reservations %}
ip dhcp pool {{ r.name }}
 host {{ r.ip }} {{ r.mask }}
 hardware-address {{ r.mac }}
 default-router {{ r.gw }}
 dns-server {{ dns }}
{%- endfor %}
!
{%- if any_dhcpv6 %}
! one DHCPv6 pool for the relayed requests: stateless clients only ask for DNS (Information-Request),
! stateful clients get an address from the prefix whose link-address matches the relay's VLAN
ipv6 dhcp pool {{ dhcpv6_pool }}
{%- for p in stateful6 %}
 address prefix {{ p.prefix }} lifetime 172800 86400
 link-address {{ p.prefix }}
{%- endfor %}
 dns-server {{ dns6 }}
 domain-name {{ site.domain }}
!
{%- endif %}
interface Loopback0
 description DHCP server address for the relays
 ip address {{ lo.v4.ip }} 255.255.255.255
 ipv6 address {{ lo.v6 }}
!
{%- for i in interfaces %}
interface {{ i.long }}
 description {{ i.desc }}
{%- if i.dhcp_client %}
 ip address dhcp
{%- else %}
 ip address {{ i.v4.ip }} {{ i.v4.netmask }}
{%- endif %}
 ipv6 address {{ i.v6 }}
{%- if i.lla %}
 ipv6 address {{ i.lla | upper }} link-local
{%- endif %}
{%- if i.peer and any_dhcpv6 %}
 ipv6 dhcp server {{ dhcpv6_pool }}
{%- endif %}
 no shutdown
!
{%- endfor %}
{%- if wan_dhcp %}
! the IPv4 default route comes from the ISP's DHCP offer (option 3), installed with AD 254
{%- else %}
ip route 0.0.0.0 0.0.0.0 {{ default_v4 }}
{%- endif %}
ip route {{ summary.network_address }} {{ summary.netmask }} {{ primary_hop }}
ip route {{ summary.network_address }} {{ summary.netmask }} {{ backup_hop }} {{ floating_ad }}
{%- for h in host_routes %}
ip route {{ h.dest }} 255.255.255.255 {{ h.hop }}
{%- endfor %}
{%- if site_block %}
ip route {{ site_block.network_address }} {{ site_block.netmask }} Null0
{%- endif %}
ipv6 route ::/0 {{ default6 }}
ipv6 route {{ summary6 }} {{ primary_hop6 }}
ipv6 route {{ summary6 }} {{ backup_hop6 }} {{ floating_ad }}
{%- for h in host_routes6 %}
ipv6 route {{ h.dest }}/128 {{ h.hop }}
{%- endfor %}
{%- if site_block6 %}
ipv6 route {{ site_block6 }} Null0
{%- endif %}
!
end
