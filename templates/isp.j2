{% include "_base.j2" %}
ipv6 unicast-routing
!
{%- if customer_pool %}
! the customer's router takes its outside address by DHCP; the /30 has one address left to give
ip dhcp excluded-address {{ customer_pool.gw }}
ip dhcp pool CUSTOMER-HU01
 network {{ customer_pool.net.network_address }} {{ customer_pool.net.netmask }}
 default-router {{ customer_pool.gw }}
!
{%- endif %}
{%- for i in interfaces %}
interface {{ i.long }}
 description {{ i.desc }}
 ip address {{ i.v4.ip }} {{ i.v4.netmask }}
 ipv6 address {{ i.v6 }}
{%- if i.lla %}
 ipv6 address {{ i.lla | upper }} link-local
{%- endif %}
 no shutdown
!
{%- endfor %}
! no NAT on the customer side yet (ENSA): the customer's whole block is routed back to R1
ip route {{ summary.network_address }} {{ summary.netmask }} {{ r1_v4 }}
ipv6 route {{ summary6 }} {{ r1_v6 }}
!
end
